[alias]
    co = checkout
    br = branch
    # commit with full diff in editor
    ci = commit -v
    # short status with branch line
    st = status -sb
    # unstage a file: git unstage <file>
    unstage = reset HEAD --
    # show last commit
    last = log -1 HEAD
    # graph log with author and relative date
    hist = log --graph --pretty=compact --abbrev-commit
    # delete all merged local branches
    prune-local = !git branch --merged | grep -v \"^\\*\" | xargs git branch -d
    # commit count per author (no merges); optional args e.g. --since="6 months ago"
    stats = "!f() { git --no-pager shortlog -sne --no-merges \"$@\" HEAD; }; f"
    # what changed since last pull
    whatsnew = log HEAD@{1}..
    # commits on remote not yet pulled
    incoming = "!git remote update -p; git log --graph --pretty=compact --abbrev-commit ..@{u}"
    # commits on origin's default branch not in current branch
    incoming-origin = "!f() { git remote update -p; ref=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD) || { echo 'origin/HEAD is not set; run: git remote set-head origin -a' >&2; return 1; }; git log --graph --pretty=compact --abbrev-commit ..\"$ref\" \"$@\"; }; f"
    # fetch latest origin/<branch> and merge it into the current branch
    merge-origin = "!f() { branch=${1#origin/}; if [ -z \"$branch\" ]; then echo 'usage: git merge-origin <branch>' >&2; return 2; fi; git fetch --prune origin \"$branch\" && git merge \"origin/$branch\"; }; f"
    # local commits not yet pushed
    outgoing = log @{u}..
    # last 10 commits, compact with relative time
    new = log --color --pretty=compact --abbrev-commit -10
    # last 10 commit messages only
    newlog = log --color --pretty=format:'%C(green)-%C(reset) %C(default)%s%C(reset)' -10
    amend-date = "!f() { GIT_COMMITTER_DATE=\"$1\" git commit --amend --no-edit --date \"$1\"; }; f"
    # show current git identity and which config file the email comes from
    whoami = "!f() { name=$(git config user.name); email=$(git config user.email); src=$(git config --show-origin user.email | awk -F'\\t' '{sub(/file:/,\"\",$1); sub(ENVIRON[\"HOME\"],\"~\",$1); print $1}'); echo \"$name <$email>  ($src)\"; }; f"
    # files with most changes in the last year (churn)
    churn = "!git log --format=format: --name-only --since='1 year ago' | sort | uniq -c | sort -nr | head -20"
    # files most often touched by bug/fix commits (bug cluster hotspots)
    bugspots = "!git log -i -E --grep='fix|bug|broken' --name-only --format='' | sort | uniq -c | sort -nr | head -20"
    # commits per month — project velocity over time
    pulse = "!git log --format='%ad' --date=format:'%Y-%m' | sort | uniq -c"
    # reactive/emergency commits in the last year (firefighting frequency)
    firefighting = "!git log --oneline --since='1 year ago' | grep -iE 'revert|hotfix|emergency|rollback'"

[pretty]
    compact = format:%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)%an%Creset %C(dim)%ae%Creset

[branch]
    autosetuprebase = always
    autosetupmerge = always

[color]
    ui = auto
    diff = auto
	status = auto
	branch = auto

[color "diff-highlight"]
	oldNormal = red
	oldHighlight = red bold 217
	newNormal = green
	newHighlight = green bold 157

[core]
    editor = vi
    excludesfile = ~/.gitignore_global
    pager = diff-so-fancy | less --tabs=4 -RFX

[pull]
    rebase = true

[push]
    default = simple

[user]
    name = Henrik Kjersem
    email = hkjersem@gmail.com

[diff]
    algorithm = patience

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	required = true
	process = git-lfs filter-process

# Machine-local overrides (untracked, generated by scripts/setup-git-local.sh)
[include]
    path = ~/.gitconfig_local

[init]
	defaultBranch = main
[credential]
	helper = osxkeychain
