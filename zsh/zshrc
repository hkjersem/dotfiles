###############################################################################
# Configuration modules                                                       #
###############################################################################

source ~/.zsh_conf.d/omz.zsh
source ~/.zsh_conf.d/plugins.zsh
source ~/.zsh_conf.d/history.zsh
source ~/.zsh_conf.d/env.zsh
source ~/.zsh_conf.d/aliases.zsh
source ~/.zsh_conf.d/prompt.zsh
source ~/.zsh_conf.d/fnm.zsh
source ~/.zsh_conf.d/fzf.zsh

###############################################################################
# Tool-managed blocks — updated automatically by installers                   #
###############################################################################

if [ -f "$HOME/google-cloud-sdk/path.zsh.inc" ]; then
  . "$HOME/google-cloud-sdk/path.zsh.inc"
  . "$HOME/google-cloud-sdk/completion.zsh.inc"
  export CLOUDSDK_COMPONENT_MANAGER_DISABLE_UPDATE_CHECK=true
fi

# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

###############################################################################
# Local overrides                                                              #
###############################################################################

if [ -f ~/.zshrc_local ]; then
  source ~/.zshrc_local
fi

# Ensure user bin directory is on PATH
if [ -d "$HOME/.local/bin" ]; then
  case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) export PATH="$HOME/.local/bin:$PATH" ;;
  esac
fi
